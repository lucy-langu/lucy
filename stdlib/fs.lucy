# Lucy filesystem library.
# Files, directories, paths, and streams use one flat public API.

func read(path) {
    return __file_read(path)
}

func write(path, content) {
    return __file_write(path, content)
}

func append(path, content) {
    return __file_append(path, content)
}

func read_lines(path) {
    return __file_lines(path)
}

func write_lines(path, lines) {
    return __file_write_lines(path, lines)
}

func exists(path) {
    return __file_exists(path) or __dir_exists(path)
}

func size(path) {
    return __file_size(path)
}

func remove(path) {
    return __file_delete(path)
}

func copy(source, destination) {
    return __file_copy(source, destination)
}

func move(source, destination) {
    return __file_move(source, destination)
}

# Atomically replace destination with a fully written temporary file.
func replace(source, destination) {
    return __file_replace(source, destination)
}

func touch(path) {
    return __file_touch(path)
}

func chmod(path, mode) {
    return __file_chmod(path, mode)
}

func chown(path, uid, gid) {
    return __file_chown(path, uid, gid)
}

func chdir(path) {
    return __dir_chdir(path)
}

func entries(path = ".") {
    return __dir_entries(path)
}

func files(path = ".") {
    return __dir_files(path)
}

func dirs(path = ".") {
    return __dir_dirs(path)
}

func mkdir(path, parents = false) {
    return __dir_mkdir(path, parents)
}

func rmdir(path, recursive = false) {
    return __dir_rmdir(path, recursive)
}

func empty(path = ".") {
    return __dir_empty(path)
}

func glob(pattern) {
    return __dir_glob(pattern)
}

func walk(path = ".") {
    return __dir_walk(path)
}

func join(parts) {
    return __path_join(parts)
}

func absolute(path) {
    return __path_absolute(path)
}

func expand(path) {
    return __path_expand(path)
}

func basename(path) {
    return __path_basename(path)
}

func dirname(path) {
    return __path_dirname(path)
}

func extension(path) {
    return __path_extname(path)
}

func stem(path) {
    return __path_stem(path)
}

func link(source, destination) {
    return __fileutils_link(source, destination)
}

func symlink(source, destination) {
    return __fileutils_symlink(source, destination)
}

func open(path, mode = "r") {
    return IO.new(path, mode)
}

func console(prompt = "") {
    return __io_read(prompt)
}

func read_json(path) {
    import data
    return data.parse(read(path))
}

func write_json(path, value) {
    import data
    return write(path, data.stringify(value))
}

class IO {
    func initialize(path = nil, mode = "r") {
        self.path = path
        self.mode = mode
        if path != nil {
            self.native = __io_open(path, mode)
        }
    }

    func print(values) {
        return print(values)
    }

    func write(text) {
        if self.native != nil {
            return __io_write_file(self.native, text)
        }
        return __io_write(text)
    }

    func read(prompt = "") {
        if self.native != nil {
            if prompt == "" {
                return __io_read_file(self.native)
            }
            return __io_read_file(self.native, int(prompt))
        }
        return __io_read(prompt)
    }

    func ask(prompt) {
        return __io_read(prompt)
    }

    func seek(offset, whence = 0) {
        return __io_seek(self.native, offset, whence)
    }

    func pos() {
        return __io_pos(self.native)
    }

    func rewind() {
        return __io_rewind(self.native)
    }

    func eof() {
        return __io_eof(self.native)
    }

    func fileno() {
        return __io_fileno(self.native)
    }

    func close() {
        return __io_close(self.native)
    }

    func pipe() {
        return __io_pipe()
    }

    func popen(command) {
        return __io_popen(command)
    }
}


# Project-oriented filesystem helpers.
func is_dir(path) {
    return __dir_exists(path)
}

func is_file(path) {
    return __file_exists(path) and !__dir_exists(path)
}

func ensure_dir(path) {
    if !is_dir(path) { mkdir(path, true) }
    return absolute(path)
}

func ensure_parent(path) {
    let parent = dirname(path)
    if parent != "" and parent != "." { mkdir(parent, true) }
    return absolute(path)
}

func read_or(path, fallback = "") {
    if !is_file(path) { return fallback }
    return read(path)
}

func write_if_changed(path, content) {
    if is_file(path) and read(path) == content { return false }
    ensure_parent(path)
    write(path, content)
    return true
}

func append_line(path, line) {
    if !is_file(path) { write(path, "") }
    append(path, str(line) + "\n")
    return size(path)
}

func touch_if_missing(path) {
    if !exists(path) { touch(path); return true }
    return false
}

func remove_if_exists(path) {
    if !exists(path) { return false }
    if is_dir(path) { rmdir(path, true) } else { remove(path) }
    return true
}

func copy_if_exists(source, destination) {
    if !is_file(source) { return false }
    ensure_parent(destination)
    copy(source, destination)
    return true
}

func move_if_exists(source, destination) {
    if !exists(source) { return false }
    ensure_parent(destination)
    move(source, destination)
    return true
}

func read_json_or(path, fallback = nil) {
    if !is_file(path) { return fallback }
    try {
        return read_json(path)
    } catch Exception as error {
        return fallback
    }
}

func write_json_pretty(path, value) {
    import data
    ensure_parent(path)
    return write(path, data.pretty(value) + "\n")
}

func list_files(path = ".") {
    return files(path).sort()
}

func list_dirs(path = ".") {
    return dirs(path).sort()
}

func file_count(path = ".") {
    return list_files(path).length()
}

func dir_count(path = ".") {
    return list_dirs(path).length()
}

func with_extension(path, extension_value) {
    var suffix_text = str(extension_value)
    if !suffix_text.starts_with(".") { suffix_text = "." + suffix_text }
    return join([dirname(path), stem(path) + suffix_text])
}

func is_absolute(path) {
    return path.starts_with("/") or text.match("^[A-Za-z]:[\\\\/]", path)
}

func is_hidden(path) {
    return basename(path).starts_with(".")
}

func same_path(left, right) {
    return absolute(left) == absolute(right)
}

func read_lines_or(path, fallback = []) {
    if !is_file(path) { return fallback }
    return read_lines(path)
}
