# Lucy math library.
# Numeric primitives such as abs(), sqrt(), pow(), sin(), min(), and max()
# are provided by the language runtime. This module contains higher-level math.

class Math {
    func square(x) {
        return x * x
    }

    func cube(x) {
        return x * x * x
    }

    func clamp(x, low, high) {
        if x < low {
            return low
        } else if x > high {
            return high
        }
        return x
    }

    func even(x) {
        return x % 2 == 0
    }

    func odd(x) {
        return x % 2 != 0
    }

    func factorial(n) {
        if n < 0 {
            throw "MathError: factorial expects a non-negative integer"
        }
        result = 1
        i = 2
        while i <= n {
            result *= i
            i += 1
        }
        return result
    }

    func gcd(a, b) {
        a = abs(a)
        b = abs(b)
        while b != 0 {
            remainder = a % b
            a = b
            b = remainder
        }
        return a
    }

    func lcm(a, b) {
        if a == 0 or b == 0 {
            return 0
        }
        return int(abs((a / self.gcd(a, b)) * b))
    }

    func average(values) {
        if values.length() == 0 {
            return nil
        }
        return sum(values) / values.length()
    }

    func lerp(a, b, t) {
        return a + (b - a) * t
    }

    func sign(x) {
        if x < 0 {
            return -1
        }
        if x > 0 {
            return 1
        }
        return 0
    }
}

math = Math.new()

func square(x) {
    return math.square(x)
}

func cube(x) {
    return math.cube(x)
}

func clamp(x, low, high) {
    return math.clamp(x, low, high)
}

func factorial(n) {
    return math.factorial(n)
}

func gcd(a, b) {
    return math.gcd(a, b)
}

func lcm(a, b) {
    return math.lcm(a, b)
}

func average(values) {
    return math.average(values)
}

func lerp(a, b, t) {
    return math.lerp(a, b, t)
}

func sign(x) {
    return math.sign(x)
}
