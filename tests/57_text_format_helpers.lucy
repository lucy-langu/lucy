import text
assert(text.blank("  ") == true)
assert(text.blank(nil) == true)
assert(text.present(nil) == false)
assert(text.present("lucy"))
assert(text.truncate("abcdefgh", 5) == "ab...")
assert(text.pad_left("7", 3, "0") == "007")
assert(text.pad_right("x", 3, ".") == "x..")
assert(text.remove_prefix("lucy-lang", "lucy-") == "lang")
assert(text.remove_suffix("main.lucy", ".lucy") == "main")
assert(text.before("a=b", "=") == "a")
assert(text.after("a=b", "=") == "b")
assert(text.count_occurrences("aaaa", "aa") == 2)
assert(text.equals_ignore_case("Lucy", "LUCY"))
assert(text.words(" one  two ") == ["one", "two"])
assert(text.join(["a", "b", "c"], ",") == "a,b,c")
assert(text.lines("a\r\nb\rc") == ["a", "b", "c"])
assert(text.ensure_prefix("main", "src/") == "src/main")
assert(text.ensure_suffix("main", ".lucy") == "main.lucy")
assert(text.indent("a\nb", ">") == ">a\n>b")
assert(text.dedent("    a\n    b") == "a\nb")
assert(text.snake_case("Lucy Project-Tool") == "lucy_project_tool")
assert(text.kebab_case("Lucy_Project Tool") == "lucy-project-tool")
assert(text.title_case("hello lucy") == "Hello Lucy")
assert(text.reverse_words("one two three") == "three two one")
println "text formatting helpers passed"
