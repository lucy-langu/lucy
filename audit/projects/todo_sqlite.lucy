import sqlite
import fs
let path = "audit-todo.sqlite"
let db = sqlite.open(path)
db.execute("CREATE TABLE IF NOT EXISTS tasks (id INTEGER PRIMARY KEY, title TEXT NOT NULL, done INTEGER NOT NULL DEFAULT 0)")
db.execute("DELETE FROM tasks")
db.execute("INSERT INTO tasks (title, done) VALUES (?, ?)", ["write tests", 0])
db.execute("INSERT INTO tasks (title, done) VALUES (?, ?)", ["audit docs", 1])
let all = db.query("SELECT id, title, done FROM tasks ORDER BY id")
println data.stringify(all)
db.execute("UPDATE tasks SET done = ? WHERE title = ?", [1, "write tests"])
let completed = db.query("SELECT title FROM tasks WHERE done = ? ORDER BY title", [1])
println data.stringify(completed)
db.begin()
db.execute("INSERT INTO tasks (title, done) VALUES (?, ?)", ["should rollback", 0])
db.rollback()
let count = db.query("SELECT COUNT(*) AS n FROM tasks")
println data.stringify(count)
db.close()
fs.remove(path)
