# Lucy system library.
# One flat public API for the host environment, processes, signals, and accounts.

func platform() {
    return PLATFORM
}

func version() {
    return VERSION
}

func argv() {
    return ARGV
}

func cwd() {
    return __dir_pwd()
}

func env(name) {
    return __os_env(name)
}

func setenv(name, value) {
    return __os_setenv(name, value)
}

func unsetenv(name) {
    return __os_unsetenv(name)
}

func home() {
    return __os_home()
}

func temp_dir() {
    return __os_temp_dir()
}

func command_exists(command) {
    return __os_command_exists(command)
}


func pid() {
    return __os_pid()
}

func ppid() {
    return __process_ppid()
}

func run(command) {
    return __process_run(command)
}

func capture(command) {
    return __process_capture(command)
}

func success(command) {
    return run(command).get("success")
}

func output(command) {
    return run(command).get("stdout")
}

func spawn(command) {
    return __process_spawn(command)
}

func wait(pid) {
    return __process_wait(pid)
}

func waitpid(pid) {
    return __process_waitpid(pid)
}

func kill(signal_number, pid) {
    return __process_kill(signal_number, pid)
}

func uid() {
    return __process_uid()
}

func gid() {
    return __process_gid()
}

func euid() {
    return __process_euid()
}

func egid() {
    return __process_egid()
}

func groups() {
    return __process_groups()
}

func clock_gettime(clock = "monotonic") {
    return __process_clock_gettime(clock)
}

func trap(signal_number, callback) {
    return __signal_trap(signal_number, callback)
}

func signals() {
    return __signal_list()
}

func signal_name(signal_number) {
    return __signal_signame(signal_number)
}

func login() {
    return __etc_getlogin()
}

func user(name) {
    return __etc_getpwnam(name)
}

func user_id(uid_value) {
    return __etc_getpwuid(uid_value)
}

func shell_split(text) {
    return __shellwords_split(text)
}

func shell_escape(text) {
    return __shellwords_escape(text)
}

func shell_join(items) {
    return __shellwords_join(items)
}
