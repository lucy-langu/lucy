# Lucy value-flow helpers.

func pipe(value, steps) {
    current = value
    for step in steps {
        current = step(current)
    }
    return current
}

func tap(value, action) {
    action(value)
    return value
}

func branch(value, predicate, yes, no = nil) {
    if predicate(value) {
        return yes(value)
    }
    if no == nil {
        return value
    }
    return no(value)
}

func repeat(value, count, step) {
    current = value
    i = 0
    while i < count {
        current = step(current)
        i += 1
    }
    return current
}
