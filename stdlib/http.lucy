# Lucy network library.
# HTTP client, TCP sockets, and DNS resolution share one flat public module.

class HTTPRequest
    def initialize(method, url, body = "", headers = nil, options = nil)
        self.method = method
        self.url = url
        self.body = body
        self.headers = headers
        self.options = options
    end

    def execute()
        if self.options
            return __http_request(self.method, self.url, self.body, self.headers, self.options)
        end
        if self.headers
            return __http_request(self.method, self.url, self.body, self.headers)
        end
        return __http_request(self.method, self.url, self.body)
    end
end

class HTTP
    def initialize(url = "", proxy = nil)
        self.url = url
        self.default_headers = nil
        self.options = {}
        if proxy
            self.options["proxy"] = proxy
        end
    end

    def headers(value)
        self.default_headers = value
        return self
    end

    def timeout(seconds)
        self.options["timeout"] = seconds
        return self
    end

    def connect_timeout(seconds)
        self.options["connect_timeout"] = seconds
        return self
    end

    def proxy(proxy_url)
        self.options["proxy"] = proxy_url
        return self
    end

    def user_agent(value)
        self.options["user_agent"] = value
        return self
    end

    def follow_redirects(value)
        self.options["follow_redirects"] = value
        return self
    end

    def insecure(value = true)
        self.options["insecure"] = value
        return self
    end

    def get(path = "")
        return self.request("GET", path)
    end

    def post(path = "", body = "")
        return self.request("POST", path, body)
    end

    def put(path = "", body = "")
        return self.request("PUT", path, body)
    end

    def patch(path = "", body = "")
        return self.request("PATCH", path, body)
    end

    def delete(path = "")
        return self.request("DELETE", path)
    end

    def head(path = "")
        return self.request("HEAD", path)
    end

    def request(method, path = "", body = "", headers = nil)
        actual_headers = headers
        if actual_headers == nil
            actual_headers = self.default_headers
        end
        if actual_headers
            return __http_request(method, self.url + path, body, actual_headers, self.options)
        end
        return __http_request(method, self.url + path, body, nil, self.options)
    end
end

# One-shot HTTP helpers.
def request(method, url, body = "", headers = nil, options = nil)
    if options
        return __http_request(method, url, body, headers, options)
    end
    if headers
        return __http_request(method, url, body, headers)
    end
    return __http_request(method, url, body)
end

def get(url, headers = nil, options = nil)
    return request("GET", url, "", headers, options)
end

def post(url, body = "", headers = nil, options = nil)
    return request("POST", url, body, headers, options)
end

def put(url, body = "", headers = nil, options = nil)
    return request("PUT", url, body, headers, options)
end

def patch(url, body = "", headers = nil, options = nil)
    return request("PATCH", url, body, headers, options)
end

def delete(url, headers = nil, options = nil)
    return request("DELETE", url, "", headers, options)
end

def head(url, headers = nil, options = nil)
    return request("HEAD", url, "", headers, options)
end

def client(url = "", proxy = nil)
    return HTTP.new(url, proxy)
end

# Low-level TCP socket API.
class Socket
    def initialize()
        self.native = __socket_new()
    end

    def connect(host, port)
        return __socket_connect(self.native, host, port)
    end

    def bind(host, port)
        return __socket_bind(self.native, host, port)
    end

    def listen(backlog = 16)
        return __socket_listen(self.native, backlog)
    end

    def accept()
        client = Socket.new()
        client.native = __socket_accept(self.native)
        return client
    end

    def recv(size = 4096)
        return __socket_recv(self.native, size)
    end

    def send(data)
        return __socket_send(self.native, data)
    end

    def close()
        return __socket_close(self.native)
    end
end

class SocketAPI
    def new()
        return Socket.new()
    end
end

socket = SocketAPI.new()

# DNS helpers.
class Resolv
    def getaddress(host)
        return __resolv_getaddress(host)
    end

    def getname(address)
        return __resolv_getname(address)
    end
end

resolv = Resolv.new()

# Convenience aliases for the flat networking API.
def connect(host, port)
    s = Socket.new()
    s.connect(host, port)
    return s
end

def bind(host, port)
    s = Socket.new()
    s.bind(host, port)
    return s
end

def listen(socket, backlog = 16)
    return socket.listen(backlog)
end

def accept(socket)
    return socket.accept()
end

def recv(socket, size = 4096)
    return socket.recv(size)
end

def send(socket, data)
    return socket.send(data)
end

def close(socket)
    return socket.close()
end

def resolve(host)
    return __resolv_getaddress(host)
end

def reverse(address)
    return __resolv_getname(address)
end

http = HTTP.new()
