# Execute Lucy documentation examples with the current Lucy executable.
import fs
import system

let ROOT = fs.absolute(".")
let EXECUTABLE = ARGV.length() > 0 ? fs.absolute(ARGV[0]) : fs.join([ROOT, "build", "lucy"])
if !fs.exists(EXECUTABLE) {
    println "Lucy executable not found: " + EXECUTABLE
    exit(2)
}

system.setenv("LUCY_PATH", fs.join([ROOT, "stdlib"]))
let TEMP = fs.join([system.temp_dir(), "lucy-doc-check-" + str(system.pid())])
fs.mkdir(TEMP, true)
let ORIGINAL_CWD = system.cwd()
let passed = []
let skipped = []
let failed = []

func shell_quote(value) {
    return system.shell_escape(value)
}

func run_example(name, source_text, base_dir) {
    let source_path = fs.join([TEMP, name + ".lucy"])
    fs.write(source_path, source_text + "\n")
    fs.chdir(base_dir)
    let result = system.run(shell_quote(EXECUTABLE) + " " + shell_quote(source_path) + " 2>&1")
    fs.chdir(ORIGINAL_CWD)
    if result.get("success") {
        passed.push(name)
        println "PASS " + name
    } else {
        failed.push({"name": name, "detail": result.get("stdout")})
        println "FAIL " + name + " (exit " + str(result.get("status")) + ")"
        if result.get("stdout") != "" { println result.get("stdout") }
    }
}

for filename in fs.files("docs/stdlib") {
    if !filename.ends_with(".md") { continue }
    let name = fs.stem(filename)
    let doc = fs.read(fs.join(["docs/stdlib", filename]))
    let sections = doc.split("## Quick example")
    if sections.length() < 2 { continue }
    let fences = sections[1].split("```lucy")
    if fences.length() < 2 { continue }
    let code = fences[1].split("```")[0].strip()
    if name == "http" {
        skipped.push(name)
        println "SKIP docs/stdlib/" + filename + " (network-dependent)"
    } else {
        run_example(name, code, TEMP)
    }
}

let builtin_doc = fs.read("docs/BUILTIN_REFERENCE.md")
let example_sections = builtin_doc.split("## Examples")
if example_sections.length() > 1 {
    let fences = example_sections[1].split("```lucy")
    if fences.length() > 1 {
        run_example("BUILTIN_REFERENCE", fences[1].split("```")[0].strip(), TEMP)
    }
}

fs.chdir(ORIGINAL_CWD)
fs.rmdir(TEMP, true)
println "Documentation examples: " + str(passed.length()) + " passed, " + str(skipped.length()) + " skipped, " + str(failed.length()) + " failed"
exit(failed.length() == 0 ? 0 : 1)
