import fs
import system
let root = fs.join([system.temp_dir(), "lucy-fs-api-test"])
fs.remove_if_exists(root)
fs.ensure_dir(fs.join([root, "nested"]))
assert(fs.is_dir(root))
assert(fs.is_file(fs.join([root, "nested", "sample.txt"])) == false)
assert(fs.list_dirs(root) == ["nested"])
assert(fs.is_file(fs.join([root, "nested", "missing.txt"])) == false)
let file = fs.join([root, "nested", "sample.txt"])
assert(fs.write_if_changed(file, "alpha\n") == true)
assert(fs.write_if_changed(file, "alpha\n") == false)
assert(fs.read_or(file, "fallback") == "alpha\n")
assert(fs.append_line(file, "beta") > 0)
assert(fs.read_lines_or(file, []).length() == 2)
assert(fs.touch_if_missing(fs.join([root, "touch.txt"])) == true)
assert(fs.touch_if_missing(fs.join([root, "touch.txt"])) == false)
assert(fs.list_files(root).contains("touch.txt"))
assert(fs.copy_if_exists(file, fs.join([root, "copy.txt"])) == true)
assert(fs.is_file(fs.join([root, "copy.txt"])))
assert(fs.move_if_exists(fs.join([root, "copy.txt"]), fs.join([root, "moved.txt"])) == true)
assert(fs.remove_if_exists(fs.join([root, "moved.txt"])) == true)
assert(fs.remove_if_exists(fs.join([root, "moved.txt"])) == false)
assert(fs.with_extension("src/main", "lucy") == "src/main.lucy")
assert(fs.is_absolute(fs.absolute(".")))
assert(fs.is_hidden(".env"))
assert(fs.same_path(".", fs.absolute(".")))
assert(fs.file_count(fs.join([root, "nested"])) == 1)
assert(fs.dir_count(root) == 1)
fs.write_json_pretty(fs.join([root, "meta.json"]), {"ok": true})
assert(fs.read_json_or(fs.join([root, "meta.json"])).get("ok") == true)
assert(fs.read_json_or(fs.join([root, "absent.json"]), {"fallback": true}).get("fallback") == true)
assert(fs.ensure_parent(fs.join([root, "a", "b", "file.txt"])) != "")
assert(fs.remove_if_exists(root))
println "filesystem project helpers passed"
