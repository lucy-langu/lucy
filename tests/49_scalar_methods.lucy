assert("lucy".capitalize() == "Lucy")
assert("abc".chars() == ["a", "b", "c"])
assert("hello".index_of("ll") == 2)
assert("hello".index_of("z") == nil)
assert(42.to_i() == 42)
assert(42.to_f() == 42.0)
assert("42".to_i() == 42)
assert("3.5".to_f() == 3.5)
assert(42.is_integer?())
assert(3.5.is_integer?() == false)
assert(4.even?())
assert(5.odd?())
assert(4.positive?())
assert((-4).negative?())
assert(0.zero?())
assert(15.clamp(0, 10) == 10)
assert((-2).clamp(0, 10) == 0)
println "scalar methods passed"
