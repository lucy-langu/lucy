# Lucy data library.
# Collection literals and common scalar operations are language features.
# This module focuses on structured data formats and map shaping.

func pick(source, keys) {
    result = {}
    for key in keys {
        if source.has(key) {
            result.set(key, source.get(key))
        }
    }
    return result
}

func omit(source, keys) {
    result = {}
    for key in source.keys() {
        if !keys.contains(key) {
            result.set(key, source.get(key))
        }
    }
    return result
}

func merge(left, right) {
    result = {}
    for key in left.keys() {
        result.set(key, left.get(key))
    }
    for key in right.keys() {
        result.set(key, right.get(key))
    }
    return result
}

func values(source, keys) {
    result = []
    for key in keys {
        result.push(source.get(key))
    }
    return result
}

func zip(keys, values) {
    result = {}
    i = 0
    while i < keys.length() and i < values.length() {
        result.set(keys[i], values[i])
        i += 1
    }
    return result
}

class JSON {
    func parse(text) {
        return __json_parse(text)
    }

    func stringify(value) {
        return __json_stringify(value)
    }

    func pretty(value) {
        return __json_pretty(value)
    }

    func load(path) {
        import fs
        return self.parse(fs.read(path))
    }

    func dump(path, value) {
        import fs
        return fs.write(path, self.stringify(value))
    }
}

json = JSON.new()

func parse(text) {
    return json.parse(text)
}

func stringify(value) {
    return json.stringify(value)
}

func pretty(value) {
    return json.pretty(value)
}

func json_read(path) {
    return json.load(path)
}

func json_write(path, value) {
    return json.dump(path, value)
}

class YAML {
    func load(text) {
        return __yaml_load(text)
    }

    func dump(value) {
        return __yaml_dump(value)
    }

    func load_file(path) {
        import fs
        return self.load(fs.read(path))
    }
}

yaml = YAML.new()

func yaml_load(text) {
    return yaml.load(text)
}

func yaml_dump(value) {
    return yaml.dump(value)
}

class CSV {
    func parse(text, delimiter = ",") {
        return __csv_parse(text, delimiter)
    }

    func stringify(rows, delimiter = ",") {
        return __csv_stringify(rows, delimiter)
    }

    func load(path, delimiter = ",") {
        import fs
        return self.parse(fs.read(path), delimiter)
    }

    func dump(path, rows, delimiter = ",") {
        import fs
        return fs.write(path, self.stringify(rows, delimiter))
    }
}

csv = CSV.new()

func csv_parse(text, delimiter = ",") {
    return csv.parse(text, delimiter)
}

func csv_stringify(rows, delimiter = ",") {
    return csv.stringify(rows, delimiter)
}
