class Stack {
    func initialize() {
        self.items = []
    }
    func push(value) {
        self.items.push(value)
        return self.items.length()
    }
    func pop() {
        return self.items.pop()
    }
    func peek() {
        return self.items.last()
    }
    func size() {
        return self.items.length()
    }
    func is_empty() {
        return self.items.length() == 0
    }
    func clear() {
        self.items.clear()
        return self
    }
    func to_array() {
        let result = []
        for value in self.items {
            result.push(value)
        }
        return result
    }
}
