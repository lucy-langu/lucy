import system
system.setenv("LUCY_TEST_BOOL", "yes")
system.setenv("LUCY_TEST_INT", "42")
system.setenv("LUCY_TEST_FLOAT", "3.5")
assert(system.env_present("LUCY_TEST_BOOL"))
assert(system.env_or("LUCY_TEST_MISSING", "fallback") == "fallback")
assert(system.env_bool("LUCY_TEST_BOOL") == true)
assert(system.env_bool("LUCY_TEST_MISSING", true) == true)
assert(system.env_int("LUCY_TEST_INT") == 42)
assert(system.env_int("LUCY_TEST_MISSING", 7) == 7)
assert(system.env_float("LUCY_TEST_FLOAT") == 3.5)
assert(system.setenv_if_missing("LUCY_TEST_BOOL", "no") == false)
assert(system.is_unix() or system.is_windows())
assert(system.is_linux() or system.is_macos() or system.is_windows())
assert(system.is_windows() == (system.platform().lower().contains("windows")))
assert(system.require_command("cmake"))
let output = system.exec_stdout(["cmake", "-E", "echo", "paw-system-test"])
assert(output.contains("paw-system-test"))
assert(system.exec_success(["cmake", "-E", "true"]))
assert(system.exec_status(["cmake", "-E", "true"]) == 0)
assert(system.exec_stderr(["cmake", "-E", "echo", "ignored"]) == "")
assert(system.exec_text(["cmake", "-E", "echo", "text"]).contains("text"))
assert(system.exec_first_line(["cmake", "-E", "echo", "first"]).contains("first"))
assert(system.exec_lines(["cmake", "-E", "echo", "line"]).length() == 1)
assert(system.exec_checked(["cmake", "-E", "true"]).get("success"))
assert(system.exec_or(["cmake", "-E", "false"], "fallback") == "fallback")
let json_value = system.exec_json(["cmake", "-E", "echo", "{\"ok\":true}"])
assert(json_value.get("ok") == true)
let info = system.process_info()
assert(info.get("pid") > 0)
assert(info.get("platform") == system.platform())
println "system process helpers passed"
