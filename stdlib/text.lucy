# Lucy text library.
# Basic string transformations are native string methods.
# This module exposes regex, encoding, scanning, and shell-word operations.

func match(pattern, text) {
    return __regex_match(pattern, text)
}

func search(pattern, text) {
    return __regex_search(pattern, text)
}

func find_all(pattern, text) {
    return __regex_find_all(pattern, text)
}

func replace_regex(pattern, replacement, text) {
    return __regex_replace(pattern, replacement, text)
}

func base64_encode(text) {
    return __encoding_base64_encode(text)
}

func base64_decode(text) {
    return __encoding_base64_decode(text)
}

func hex_encode(text) {
    return __encoding_hex_encode(text)
}

func hex_decode(text) {
    return __encoding_hex_decode(text)
}

func url_encode(text) {
    return __encoding_url_encode(text)
}

func url_decode(text) {
    return __encoding_url_decode(text)
}

func scanner(text) {
    return StringScanner.new(text)
}

func shell_split(text) {
    return __shellwords_split(text)
}

func shell_escape(text) {
    return __shellwords_escape(text)
}

func shell_join(items) {
    return __shellwords_join(items)
}

class StringScanner {
    func initialize(text) {
        self.native = __stringscanner_new(text)
    }

    func scan(pattern) {
        return __stringscanner_scan(self.native, pattern)
    }

    func scan_until(pattern) {
        return __stringscanner_scan_until(self.native, pattern)
    }

    func skip(pattern) {
        return __stringscanner_skip(self.native, pattern)
    }

    func skip_until(pattern) {
        value = self.scan_until(pattern)
        if value == nil {
            return nil
        }
        return value.length()
    }

    func check(pattern) {
        return __stringscanner_check(self.native, pattern)
    }

    func check_until(pattern) {
        return __stringscanner_check_until(self.native, pattern)
    }

    func match?() {
        return self.native.get("matched") != nil
    }

    func matched() {
        return self.native.get("matched")
    }

    func matched_size() {
        value = self.native.get("matched")
        if value == nil {
            return 0
        }
        return value.length()
    }

    func pre_match() {
        return self.native.get("pre_match")
    }

    func post_match() {
        return self.native.get("post_match")
    }
}
