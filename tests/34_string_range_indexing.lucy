let text = "hello world"
assert text[0..4] == "hello"
assert text[0...4] == "hell"
assert text[6..10] == "world"
assert text[-5..-1] == "world"
assert text[0..0] == "h"
assert text[5..4] == ""
assert text[100..200] == ""
assert text[0] == "h"
assert text[-1] == "d"

let unicode = "hé🙂x"
assert unicode.length() == 4
assert unicode[0] == "h"
assert unicode[1] == "é"
assert unicode[2] == "🙂"
assert unicode[1..2] == "é🙂"
assert unicode[1...3] == "é🙂"

println "string range indexing tests passed"
