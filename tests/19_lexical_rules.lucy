# Lucy 2.0 lexical regression tests.
let exponent = 1.5e2
let negative_exponent = 2e-3
assert exponent === 150.0
assert negative_exponent === 0.002

let escaped = "line\nnext\tindent\0"
let controls = "\a\b\f\v\r\/"
let hex_escape = "A\x42"
let unicode_escape = "Lucy \u263A"
assert escaped.length() == 17
assert controls.length() == 6
assert controls.char_at(0) == "\a"
assert controls.char_at(1) == "\b"
assert controls.char_at(2) == "\f"
assert controls.char_at(3) == "\v"
assert controls.char_at(4) == "\r"
assert controls.char_at(5) == "/"
assert hex_escape == "AB"
assert unicode_escape == "Lucy ☺"

let continued = 1 + \
    2
assert continued == 3
let string_continued = "left\
right"
assert string_continued == "leftright"

println "lexical rules passed"
