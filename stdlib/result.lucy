# Lucy explicit result values.
# Result values are maps so they remain inspectable and serializable.

func ok(value) {
    return {ok: true, value: value, error: nil}
}

func err(message) {
    return {ok: false, value: nil, error: str(message)}
}

func success(result) {
    return result.has("ok") and result.get("ok")
}

func unwrap(result, fallback = nil) {
    if success(result) {
        return result.get("value")
    }
    return fallback
}

func message(result) {
    if result.has("error") {
        return result.get("error")
    }
    return nil
}
